
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#10182d">
  <title>VCL 2026 | Vatkhura Cricket League</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --bg: #0b1020;
      --card: #151e35;
      --blue: #1e88e5;
      --purple: #6a11cb;
      --cyan: #08d9f5;
      --text: #f4f7ff;
      --muted: #a9b5cc;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    /* Navigation */
    .navbar {
      position: sticky;
      top: 0;
      z-index: 100;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 30px;
      padding: 18px 12px;
      background: rgba(16, 29, 55, 0.97);
      border-bottom: 1px solid rgba(8, 217, 245, 0.18);
      backdrop-filter: blur(12px);
    }

    .navbar a {
      font-size: 15px;
      font-weight: 700;
      color: #d5def1;
      padding: 5px 0;
      position: relative;
      white-space: nowrap;
      transition: color 0.25s;
    }

    .navbar a:hover,
    .navbar a.active {
      color: white;
    }

    .navbar a.active::after {
      content: "";
      position: absolute;
      bottom: -8px;
      left: 0;
      width: 100%;
      height: 3px;
      border-radius: 5px;
      background: var(--cyan);
    }

    /* Hero */
    .hero {
      position: relative;
      overflow: hidden;
      text-align: center;
      padding: 42px 18px 55px;
      background:
        radial-gradient(ellipse at 50% 10%,
          rgba(42, 82, 152, 0.45), transparent 65%),
        linear-gradient(145deg, #10182d, #17142e 65%, #11182b);
    }

    .hero::before {
      content: "";
      position: absolute;
      width: 270px;
      height: 270px;
      border-radius: 50%;
      background: rgba(106, 17, 203, 0.14);
      filter: blur(75px);
      top: 30px;
      left: 50%;
      transform: translateX(-50%);
      pointer-events: none;
    }

    .logo-wrap {
      position: relative;
      max-width: 330px;
      margin: 0 auto 25px;
      animation: appear 0.8s ease both;
    }

    .logo-wrap img {
      display: block;
      width: 100%;
      height: auto;
      object-fit: contain;
      border-radius: 12px;
    }

    .eyebrow {
      display: inline-block;
      border: 1px solid rgba(8, 217, 245, 0.45);
      color: var(--cyan);
      background: rgba(8, 217, 245, 0.07);
      border-radius: 30px;
      padding: 8px 16px;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 2px;
      margin-bottom: 16px;
    }

    .hero h1 {
      position: relative;
      font-size: clamp(28px, 7vw, 44px);
      font-weight: 900;
      line-height: 1.15;
      letter-spacing: -1px;
      margin-bottom: 15px;
    }

    .hero h1 span {
      background: linear-gradient(90deg, #08d9f5, #7288ff, #c084fc);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .hero p {
      max-width: 450px;
      margin: 0 auto;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.8;
    }

    .hero-buttons {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 12px;
      margin-top: 27px;
    }

    .btn {
      display: inline-block;
      padding: 13px 21px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 800;
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .btn:hover {
      transform: translateY(-3px);
    }

    .btn-primary {
      color: #071321;
      background: linear-gradient(100deg, #08d9f5, #7a9cff);
      box-shadow: 0 6px 22px rgba(8, 217, 245, 0.16);
    }

    .btn-secondary {
      border: 1px solid #465675;
      color: white;
      background: rgba(255, 255, 255, 0.035);
    }

    /* Main content */
    .container {
      width: min(100% - 32px, 900px);
      margin: 0 auto;
    }

    .section {
      padding: 36px 0;
    }

    .section-heading {
      text-align: center;
      margin-bottom: 23px;
    }

    .section-heading small {
      color: var(--cyan);
      text-transform: uppercase;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 2px;
    }

    .section-heading h2 {
      font-size: 23px;
      margin-top: 8px;
    }

    .section-heading p {
      color: var(--muted);
      font-size: 12px;
      margin-top: 9px;
      line-height: 1.7;
    }

    /* Stats */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
    }

    .stat-card {
      text-align: center;
      background: linear-gradient(145deg, #18233e, #121a2e);
      border: 1px solid #273653;
      border-radius: 12px;
      padding: 23px 6px;
      transition: transform 0.25s, border-color 0.25s;
    }

    .stat-card:hover {
      transform: translateY(-4px);
      border-color: #08aeca;
    }

    .stat-icon {
      font-size: 23px;
      margin-bottom: 12px;
    }

    .stat-card strong {
      display: block;
      font-size: clamp(22px, 5vw, 30px);
      color: white;
      margin-bottom: 7px;
    }

    .stat-card span {
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.5px;
      color: var(--muted);
      text-transform: uppercase;
    }

    /* Quick links */
    .quick-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    .quick-card {
      display: flex;
      align-items: center;
      gap: 13px;
      padding: 18px 14px;
      min-width: 0;
      background: var(--card);
      border: 1px solid #293651;
      border-radius: 12px;
      transition: transform 0.25s, border-color 0.25s;
    }

    .quick-card:hover {
      transform: translateY(-3px);
      border-color: var(--cyan);
    }

    .quick-icon {
      flex-shrink: 0;
      display: grid;
      place-items: center;
      width: 43px;
      height: 43px;
      font-size: 21px;
      border-radius: 10px;
      background: linear-gradient(135deg,
        rgba(30, 136, 229, 0.22),
        rgba(106, 17, 203, 0.22));
    }

    .quick-info {
      min-width: 0;
    }

    .quick-info h3 {
      font-size: 13px;
      margin-bottom: 6px;
    }

    .quick-info p {
      color: var(--muted);
      font-size: 10px;
      line-height: 1.6;
    }

    .arrow {
      color: var(--cyan);
      font-size: 18px;
      margin-left: auto;
    }

    /* About */
    .about-card {
      padding: 24px 20px;
      background: linear-gradient(120deg,
        rgba(30, 60, 114, 0.45),
        rgba(106, 17, 203, 0.18));
      border: 1px solid #34456c;
      border-radius: 14px;
      text-align: center;
    }

    .about-card h2 {
      font-size: 21px;
      margin-bottom: 13px;
    }

    .about-card p {
      color: #c0cbe0;
      font-size: 13px;
      line-height: 1.9;
    }

    /* Footer */
    footer {
      margin-top: 25px;
      padding: 27px 16px;
      text-align: center;
      background: #080d19;
      border-top: 1px solid #202b41;
    }

    footer strong {
      font-size: 16px;
      letter-spacing: 1px;
    }

    footer p {
      color: var(--muted);
      font-size: 11px;
      line-height: 1.8;
      margin-top: 10px;
    }

    .footer-links {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 18px;
      margin-top: 15px;
    }

    .footer-links a {
      color: #c3d2ec;
      font-size: 11px;
    }

    @keyframes appear {
      from {
        opacity: 0;
        transform: translateY(12px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (min-width: 700px) {
      .hero {
        padding: 55px 25px 65px;
      }

      .logo-wrap {
        max-width: 350px;
      }

      .stats-grid {
        gap: 18px;
      }

      .quick-grid {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }

      .quick-card {
        display: block;
        padding: 22px 15px;
      }

      .quick-icon {
        margin-bottom: 15px;
      }

      .arrow {
        display: block;
        margin-top: 12px;
      }
    }

    @media (max-width: 380px) {
      .navbar {
        gap: 17px;
        padding: 16px 8px;
      }

      .navbar a {
        font-size: 12px;
      }

      .stats-grid {
        gap: 7px;
      }

      .stat-card {
        padding: 18px 3px;
      }

      .stat-card span {
        font-size: 9px;
      }

      .quick-grid {
        gap: 9px;
      }

      .quick-card {
        padding: 14px 9px;
        gap: 8px;
      }

      .quick-icon {
        width: 34px;
        height: 34px;
        font-size: 17px;
      }
    }
  </style>
</head>

